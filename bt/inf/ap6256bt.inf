[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
CatalogFile = ap6256bt.cat

DriverVer   = 01/01/1999,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
ap6256bt.sys = 1,,
ap6256btprops.dll = 1,,
BCM4345C5.hcd = 1,,

[ControlFlags]
ExcludeFromSelect = *

[Manufacturer]
%ManufacturerName% = AP6256BtModels, NTARM64.10.0...16299

[AP6256BtModels.NTARM64.10.0...16299]
%AP6256Bt.DeviceDesc% = AP6256Bt.Install, ACPI\BCM2EA6
%AP6256Bt.DeviceDesc% = AP6256Bt.Install, ACPI\BCM2EA4

[AP6256Bt.Install]
CopyFiles = AP6256Bt.CopyFiles
AddReg = AP6256Bt.Properties

[AP6256Bt.CopyFiles]
ap6256bt.sys
ap6256btprops.dll
BCM4345C5.hcd

[AP6256Bt.Properties]
HKR,,EnumPropPages32,0,"%13%\ap6256btprops.dll,Ap6256BtPropPageProvider"
HKR,,DebugLogLevel,0x10003,0

[AP6256Bt.Install.HW]
AddReg = AP6256Bt.Hardware

[AP6256Bt.Hardware]
HKR,,DeviceCharacteristics,0x10001,0x0100
HKR,,Security,,"D:P(A;;GA;;;BA)(A;;GA;;;SY)(A;;GA;;;LS)"

[AP6256Bt.Install.Services]
AddService = ap6256bt, 0x00000002, AP6256Bt.Service

[AP6256Bt.Install.Wdf]
KmdfService = ap6256bt, AP6256Bt.Wdf

[AP6256Bt.Wdf]
KmdfLibraryVersion = $KMDFVERSION$

[AP6256Bt.Service]
DisplayName    = %AP6256Bt.ServiceDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %13%\ap6256bt.sys
AddReg         = AP6256Bt.Parameters

[AP6256Bt.Parameters]
HKR,Parameters,InitialBaudRate,0x10003,115200
HKR,Parameters,DownloadBaudRate,0x10003,921600
HKR,Parameters,OperationalBaudRate,0x10003,3000000
HKR,Parameters,SkipFwDownload,0x10001,0
HKR,Parameters,FirmwareDirectory,0x00000000,"%13%\"
HKR,Parameters,RAMPatchFileName,0x00000000,"BCM4345C5.hcd"
HKR,Parameters,PostLaunchDelayMs,0x10003,250
HKR,Parameters,DevWakeGpioIndex,0x10001,0
HKR,Parameters,RegOnGpioIndex,0x10001,1
HKR,Parameters,RegOnDelayMs,0x10003,100
HKR,Parameters,BtWakeActiveHigh,0x10001,1
HKR,Parameters,HostWakeActiveHigh,0x10001,1
HKR,Parameters,ConfigureSleepMode,0x10003,1
HKR,Parameters,ConfigureAudio,0x10003,1
HKR,Parameters,PCMClockMode,0x10001,0
HKR,Parameters,PCMFillMethod,0x10001,2
HKR,Parameters,PCMFillNum,0x10001,0
HKR,Parameters,PCMFillValue,0x10001,3
HKR,Parameters,PCMInCallBitclock,0x10001,0
HKR,Parameters,PCMLSBFirst,0x10001,0
HKR,Parameters,PCMRightJustify,0x10001,0
HKR,Parameters,PCMRouting,0x10001,0
HKR,Parameters,PCMShortFrameSync,0x10001,0
HKR,Parameters,PCMSyncMode,0x10001,0

[Strings]
ProviderName          = "Rubik Pi 3 WoA Project"
ManufacturerName      = "SparkLAN / AMPAK (BCM43456)"
DiskName              = "AP6256 Driver Installation Disk"
AP6256Bt.DeviceDesc   = "SparkLAN AP6256 Bluetooth (UART)"
AP6256Bt.ServiceDesc  = "AP6256 Bluetooth UART H4 Transport"
