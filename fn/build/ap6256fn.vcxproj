<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|ARM64"><Configuration>Release</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64"><Configuration>Debug</Configuration><Platform>ARM64</Platform></ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <Ap6256BuildVersion Condition="'$(Ap6256BuildVersion)'==''">1.0.0.0</Ap6256BuildVersion>
    <ProjectGuid>{A6256F02-FEE0-4256-AF62-56A9BF02D0F2}</ProjectGuid>
    <RootNamespace>ap6256fn</RootNamespace>
    <TargetVersion>Windows10</TargetVersion>
    <MinimumVisualStudioVersion>14.0</MinimumVisualStudioVersion>
    <Configuration>Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">ARM64</Platform>

    <Inf2CatWindowsVersionList>10_RS3_ARM64</Inf2CatWindowsVersionList>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <RunCodeAnalysis>true</RunCodeAnalysis>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <SpectreMitigation>false</SpectreMitigation>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <PreprocessorDefinitions>POOL_NX_OPTIN=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>

    <ResourceCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)..\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
    <ResourceCompile Condition="'$(Configuration)'=='Debug'">
      <PreprocessorDefinitions>DBG=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
    <Link>

      <AdditionalDependencies>sdbus.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Inf>
      <SpecifyDriverVerDirectiveDate>true</SpecifyDriverVerDirectiveDate>
      <DateStamp>*</DateStamp>
      <SpecifyDriverVerDirectiveVersion>true</SpecifyDriverVerDirectiveVersion>
      <TimeStamp>$(Ap6256BuildVersion)</TimeStamp>
      <SpecifyArchitecture>true</SpecifyArchitecture>
      <Architecture Condition="'$(Platform)'=='ARM64'">arm64</Architecture>
    </Inf>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="..\src\fn.c" />
    <ClCompile Include="..\src\logging.c" />
    <ClInclude Include="..\src\logging.h" />
    <ResourceCompile Include="..\src\ap6256fn.rc" />
  </ItemGroup>
  <ItemGroup>
    <Inf Include="..\inf\ap6256fn.inf" />
    <FilesToPackage Include="$(TargetPath);$(OutDir)ap6256fnprops.dll" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <Target Name="Ap6256FnBuildProperties" BeforeTargets="PrepareForBuild">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\props\ap6256fnprops.vcxproj" Targets="Build" Properties="OutDir=$(OutDir);IntDir=$(IntDir)props\;SupportsPackaging=false;EnableInf2cat=false" />
  </Target>

  <Target Name="Ap6256FnStageBinary" AfterTargets="DriverPackageTarget" BeforeTargets="Inf2Cat">
    <MakeDir Directories="$(OutDir)$(TargetName)\" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(OutDir)$(TargetName)\"
          SkipUnchangedFiles="false" Condition="Exists('$(TargetPath)')" />
    <Copy SourceFiles="$(OutDir)ap6256fnprops.dll" DestinationFolder="$(OutDir)$(TargetName)\" SkipUnchangedFiles="false" />
  </Target>
  <ItemDefinitionGroup Condition="'$(Ap6256UseBuildVersion)'=='true'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(Ap6256BuildMetadataDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>AP6256_BUILD_VERSION_GENERATED=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(Ap6256BuildMetadataDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>AP6256_BUILD_VERSION_GENERATED=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>
</Project>
